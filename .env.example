# ==============================================================================
# Jama API
# ==============================================================================
JAMA_BASE_URL=https://your-jama-instance/rest/v1
JAMA_PROJECT_ID=
ROOT_PARENT_ITEM_ID=
INPUT_FILE=input/EAGLET SS Jama IMPORT.xlsx

# ==============================================================================
# Authentication
# ==============================================================================
JAMA_CLIENT_ID=
JAMA_CLIENT_SECRET=

# Optional alternatives
# JAMA_BEARER_TOKEN=
# JAMA_USERNAME=
# JAMA_PASSWORD=

# ==============================================================================
# SSL
# ==============================================================================
JAMA_SSL_VERIFY=true
JAMA_SSL_CERT=certs/jama_cert_chain.pem

# ==============================================================================
# Import Behavior
# ==============================================================================
IMPORT_MODE=upsert
DRY_RUN=true

# Folder resolution:
# Excel Folder IDs are treated as Jama documentKeys for lookup.
# If folder not found and CREATE_MISSING_FOLDERS=true, script creates it.
RESOLVE_EXISTING_FOLDERS_BY_DOCUMENT_KEY=true
USE_EXCEL_ID_AS_DOCUMENT_KEY=true
CREATE_MISSING_FOLDERS=true
USE_FOLDER_DOCUMENT_KEY_CACHE=true

# Use Global ID column for existing item lookup when populated.
# Global ID is usually more stable than documentKey.
USE_GLOBAL_ID_LOOKUP=true

# Pre-POST duplicate check using parent+itemType+name matching.
# Prevents duplicate creation after interrupted runs.
ENABLE_PRE_POST_DUPLICATE_CHECK=true

# ==============================================================================
# Item Type IDs
# ==============================================================================
JAMA_ITEM_TYPE_SET=31
JAMA_ITEM_TYPE_FOLDER=32
JAMA_ITEM_TYPE_TEXT=33
JAMA_ITEM_TYPE_SEGMENT=243
JAMA_ITEM_TYPE_STAKEHOLDER_REQUIREMENT=97
JAMA_ITEM_TYPE_SUBSYSTEM_REQUIREMENT=87
JAMA_ITEM_TYPE_SOFTWARE_REQUIREMENT=112

# ==============================================================================
# Child Item Type Fallbacks (Optional)
# ==============================================================================
# Jama container childItemType is the type of content allowed inside the container.
# It is not the type of the folder itself.
#
# The script determines childItemType by:
#   1. Inheriting from parent container (most common)
#   2. Inferring from requirement rows under the folder
#
# These settings are FALLBACK ONLY - used if both methods above fail.
# Most imports don't need these settings.
#
# DEFAULT_REQUIREMENT_CHILD_ITEM_TYPE:
#   Optional fallback for empty/new branches where parent metadata cannot determine childItemType.
#   Examples: Software Requirement=112, Subsystem Requirement=87, Stakeholder Requirement=97.
#
DEFAULT_REQUIREMENT_CHILD_ITEM_TYPE=

# JAMA_FOLDER_CHILD_ITEM_TYPE:
#   Legacy folder-specific fallback. Usually leave blank.
#
JAMA_FOLDER_CHILD_ITEM_TYPE=

# ==============================================================================
# Field Mappings
# ==============================================================================
# Optional source/import ID custom field. Leave blank if not mapped.
JAMA_FIELD_ID=

# Jama API field names (case-sensitive, normally lowercase).
JAMA_FIELD_NAME=name
JAMA_FIELD_DESCRIPTION=description

# Optional Jama field API name for verification method picklist.
# Leave blank for dynamic detection from cached Jama project item metadata.
#
# Dynamic detection (recommended):
#   Leave blank. Script searches cached items for fields starting with
#   "verification_method$" and uses the one matching the current item type.
#   Works even if the target Set is empty.
#
# Explicit configuration (if dynamic detection is ambiguous):
#   Set the exact field key seen in a known-good Jama item.
#   Example: verification_method$112
#
# Jama field suffixes vary by project/item type, so discover verification_method$... keys from cached item fields.
#
# Verification Method values in Excel: T / Test, A / Analysis, I / Inspection, D / Demonstration
# Payload uses a list of picklist option IDs, e.g. [422].
#
JAMA_FIELD_VERIFICATION_METHOD=

# ==============================================================================
# Advanced / Debug
# ==============================================================================
JAMA_ITEMS_PAGE_SIZE=50
DEBUG_JAMA_GET=false
DEBUG_JAMA_AUTH=false
